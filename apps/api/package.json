{
  "name": "@ticketing/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "gen:openapi": "node --env-file=../../.env dist/scripts/emit-openapi.js",
    "test:adv": "vitest run --config vitest.int.config.ts test/adversarial"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/platform-socket.io": "^11.2.11",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/websockets": "^11.2.11",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "@ticketing/platform": "workspace:*",
    "@ticketing/shared": "workspace:*",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.18",
    "nestjs-zod": "^5.6.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.11",
    "@swc/core": "^1.16.22",
    "@ticketing/testkit": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.10",
    "fast-check": "^4.10.3",
    "prisma": "^6.19.3",
    "undici": "^8.12.4",
    "unplugin-swc": "^2.0.0",
    "vite": "^7.3.8"
  }
}
