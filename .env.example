# Copy to .env:  cp .env.example .env
# Every variable of the whole stack. Values marked (secret) are PLACEHOLDERS for local dev only.
# Apps validate their own subset at startup (src/config/env.ts) and exit if something is missing.

# --- general ---------------------------------------------------------------
NODE_ENV=development
# pino level: fatal|error|warn|info|debug|trace
LOG_LEVEL=info

# --- postgres (compose) ----------------------------------------------------
POSTGRES_USER=tickets
POSTGRES_DB=tickets
# (secret)
POSTGRES_PASSWORD=dev-postgres-password-change-me
# (secret) connection string used by api, worker and the migrate job. Host `postgres` inside compose.
DATABASE_URL=postgresql://tickets:dev-postgres-password-change-me@postgres:5432/tickets
DB_POOL_MAX=20

# --- redis -------------------------------------------------------------------
# Disposable state only: BullMQ, queue cache, socket adapter, rate-limit buckets.
REDIS_URL=redis://redis:6379

# --- api -------------------------------------------------------------------
API_PORT=3001
# Label of this copy (compose sets api-1 / api-2); returned in the X-Api-Instance header.
API_INSTANCE_ID=api-1
# Public base URL (through nginx): stub redirects, links in emails.
API_PUBLIC_URL=http://localhost:8080
# Internal base URL for server-to-server calls (worker, web SSR).
API_INTERNAL_URL=http://nginx
# Comma separated CORS allowlist.
CORS_ORIGINS=http://localhost:8080
# Only peers inside these CIDRs may set the client IP via X-Forwarded-For (nginx overwrites it).
TRUSTED_PROXY_CIDRS=172.16.0.0/12,127.0.0.1/32
BODY_LIMIT_BYTES=262144
VENUE_UPLOAD_LIMIT_BYTES=2097152
# (secret) >= 32 chars
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
# (secret) >= 32 chars; pepper for hashing refresh tokens
JWT_REFRESH_PEPPER=dev-refresh-pepper-change-me-0123456789abcdef
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000
# (secret) >= 32 chars; signs ticket QR codes
QR_SIGNING_SECRET=dev-qr-signing-secret-change-me-0123456789
# Optional login throttling (all limits here; the test profile makes them loose).
LOGIN_THROTTLE_IP_MAX=20
LOGIN_THROTTLE_ACCOUNT_IP_MAX=5
LOGIN_THROTTLE_WINDOW_SECONDS=60
# Virtual queue: turns on above QUEUE_ACTIVATE_AT claimants; at most QUEUE_MAX_SELECTING people choose seats at once.
# The assignment fixes 500 / 200; the test profile lowers them (e.g. 1 for the "second buyer waits" scenario).
QUEUE_ACTIVATE_AT=500
QUEUE_MAX_SELECTING=200
# Max inbound socket messages per second per connection.
WS_MAX_MSGS_PER_SEC=20
# Registers test-only endpoints (clock offset, stub chaos switch). MUST be false outside tests.
TEST_CLOCK_ENABLED=false

# --- payment stub (module inside api) -----------------------------------------
# (secret) >= 32 chars; HMAC key of stub webhooks
STUB_WEBHOOK_SECRET=dev-stub-webhook-secret-change-me-0123456789
# Chaos mode: duplicate / delayed / out-of-order / lost webhooks, every 10th request 503.
STUB_CHAOS=false
# Stub request limit per second (excess gets 429). The assignment fixes this at 20.
STUB_RPS_LIMIT=20
STUB_CHAOS_MAX_DELAY_MS=60000
# (secret) >= 32 chars; API key the shop uses to call the stub provider API
STUB_API_KEY=dev-stub-api-key-change-me-0123456789abcdef
# How often the stub delivers due webhooks (ms)
STUB_DISPATCH_INTERVAL_MS=300
# Where the stub sends its webhooks (our api through nginx)
PAYMENT_WEBHOOK_URL=http://nginx/api/webhooks/payments
# Base URL of the stub as seen by our payment client.
PAYMENT_PROVIDER_URL=http://nginx/stub

# --- worker ----------------------------------------------------------------
WORKER_INSTANCE_ID=worker-1
WORKER_CONCURRENCY=10
# Worker-side refund rate, must stay under STUB_RPS_LIMIT.
WORKER_REFUND_RPS=15
REHYDRATE_INTERVAL_MS=15000
RECONCILE_INTERVAL_MS=60000

# --- mail stub -----------------------------------------------------------------
SMTP_HOST=mailstub
SMTP_PORT=1025
MAIL_FROM=tickets@example.test
MAILSTUB_HTTP_PORT=8025

# --- seed ----------------------------------------------------------------------
SEED_ON_START=true
# full = 50k users / 30 halls / 2000 events / 1M tickets; small = CI-sized
SEED_SCALE=full
# (secret) password shared by all seeded accounts; documented in README
SEED_USER_PASSWORD=Passw0rd-dev-seed

# --- web -----------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_WS_URL=/
NEXT_PUBLIC_DEFAULT_LOCALE=uk

# --- compose -------------------------------------------------------------------
NGINX_PORT=8080
