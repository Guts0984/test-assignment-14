{
  "name": "ticketing",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm build:shared && pnpm -r --workspace-concurrency=1 typecheck",
    "lint": "eslint .",
    "test": "pnpm build:shared && pnpm -r test",
    "test:int": "pnpm build:shared && pnpm -r --workspace-concurrency=1 test:int",
    "build": "pnpm -r build",
    "check:api-client": "node scripts/check-api-client.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "bash scripts/verify.sh",
    "stack:up": "bash scripts/stack.sh up",
    "stack:down": "bash scripts/stack.sh down",
    "e2e": "bash scripts/e2e.sh",
    "build:shared": "pnpm --filter @ticketing/shared build && pnpm --filter @ticketing/platform build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.7"
  }
}
