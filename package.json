{
  "name": "ticketing",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "test:int": "pnpm -r test:int",
    "build": "pnpm -r build",
    "check:api-client": "node scripts/check-api-client.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "bash scripts/verify.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.7"
  }
}
